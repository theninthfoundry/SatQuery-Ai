# SatQuery AI — Environment Configuration

APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Database (defaults to local sqlite for Phase 0, postgres for production/docker)
DATABASE_URL=sqlite:///./satquery.db
# DATABASE_URL=postgresql://satquery:satquery@localhost:5432/satquery_db

# File Storage
DATA_DIR=./data
MAX_UPLOAD_SIZE_MB=512

# Model Execution & Cache
MODEL_CACHE_DIR=./checkpoints
CUDA_VISIBLE_DEVICES=0
FORCE_CPU=false

# Security & CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
